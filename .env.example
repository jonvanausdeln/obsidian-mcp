# Obsidian MCP Server Configuration

# Required - Vault Path
OBSIDIAN_VAULT_PATH=/absolute/path/to/your/vault

# Optional - Hybrid Mode API Settings (requires Obsidian Local REST API plugin)
# Enabling API provides enhanced features for daily notes, templates, and plugin integration
# The server will fall back to filesystem-only mode if API is unavailable
# OBSIDIAN_API_URL=http://127.0.0.1:27123
# OBSIDIAN_API_KEY=your-api-key-here
# OBSIDIAN_VERIFY_SSL=false

# Optional - General Settings
LOG_LEVEL=info                    # debug, info, warn, error
MAX_FILE_SIZE_MB=10               # Maximum file size to read (in MB)
ENABLE_DELETE=true                # Allow delete operations
OBSIDIAN_DAILY_NOTES_FOLDER=Daily Notes,Daily  # Daily note folder candidates (comma-separated, first match wins)
RETRY_MAX_ATTEMPTS=3              # Number of retry attempts for failed operations
RETRY_BASE_DELAY=100              # Base delay for retry in milliseconds
