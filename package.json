{
  "name": "obsidian-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server for Obsidian.md - filesystem-first hybrid architecture",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:functional": "tsx scripts/functional-test.ts",
    "test:create-note": "tsx scripts/create-test-note.ts",
    "test:read-note": "tsx scripts/test-read-note.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "obsidian",
    "markdown",
    "notes",
    "knowledge-management"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^17.2.3",
    "gray-matter": "^4.0.3",
    "minimatch": "^11.0.8",
    "winston": "^3.11.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "axios": "^1.21.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitest/coverage-v8": "^1.2.0",
    "@vitest/ui": "^1.2.0",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
